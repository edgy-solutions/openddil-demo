          "where": [
            "(originator_nation IS NOT NULL AND originator_nation IN ('ATL', 'BDR')) OR (releasable_to IS NOT NULL AND releasable_to && ARRAY['ATL', 'BDR']::text[])"
          ]
        }
      ]
    },
    "empty": {
      "status": 403,
      "upstream": []
    }
  }
}
